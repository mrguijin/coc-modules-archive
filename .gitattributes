# 统一换行符：仓库内一律存 LF。
# 重要：部署脚本（deploy.sh / run-local.sh / deploy/*.sh / tools/*.sh）如果在
# Windows 上被检出成 CRLF，传到 Linux 服务器后会报
# "bad interpreter: /usr/bin/env bash^M"，所以这里强制 eol=lf。
* text=auto eol=lf

*.sh            text eol=lf
*.mjs           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# 二进制：不要做任何换行符转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.xlsx          binary
